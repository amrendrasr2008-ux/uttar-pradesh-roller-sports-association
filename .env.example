# UPRSA - Uttar Pradesh Roller Sports Association Portal
# Environment Variables Example Configuration

# Supabase Production Database Configuration (Client Side - Public Anon Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL (Optional / Production Domain)
APP_URL=https://uprsa.org.in

# Server-side SMTP Transactional Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=uprsa.official@gmail.com
SMTP_PASS=your-secure-app-password
SMTP_FROM="UPRSA Official <uprsa.official@gmail.com>"

# Google Gemini API Key for Server-Side AI Chat Helpline
GEMINI_API_KEY=

